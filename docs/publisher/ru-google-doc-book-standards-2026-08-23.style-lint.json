  "direct_paragraph_formatting_paragraphs": 4129,
  "heading_like_paragraphs_not_heading_style": [
    {
      "para_index": 2,
      "text": "\u041e\u0433\u043b\u0430\u0432\u043b\u0435\u043d\u0438\u0435",
      "style": "normal"
    },
    {
      "para_index": 6,
      "text": "\u0427\u0430\u0441\u0442\u044c I. \u041e\u0442 \u0434\u0435\u043c\u043e-\u0430\u0433\u0435\u043d\u0442\u0430 \u043a \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435",
      "style": "normal"
    },
    {
      "para_index": 10,
      "text": "\u0427\u0430\u0441\u0442\u044c II. \u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c \u0438 \u043a\u043e\u043d\u0442\u0443\u0440 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f",
      "style": "normal"
    },
    {
      "para_index": 14,
      "text": "\u0427\u0430\u0441\u0442\u044c III. \u041f\u0430\u043c\u044f\u0442\u044c, \u0437\u043d\u0430\u043d\u0438\u044f \u0438 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442",
      "style": "normal"
    },
    {
      "para_index": 18,
      "text": "\u0427\u0430\u0441\u0442\u044c IV. \u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b, \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f",
      "style": "normal"
    },
    {
      "para_index": 22,
      "text": "\u0427\u0430\u0441\u0442\u044c V. \u041d\u0430\u0434\u0435\u0436\u043d\u043e\u0441\u0442\u044c, \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0435\u043c\u043e\u0441\u0442\u044c \u0438 \u043e\u0446\u0435\u043d\u043a\u0438",
      "style": "normal"
    },
    {
      "para_index": 27,
      "text": "\u0427\u0430\u0441\u0442\u044c VI. \u041e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c, \u0440\u0435\u0435\u0441\u0442\u0440 \u0438 \u0434\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0435 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u044b",
      "style": "normal"
    },
    {
      "para_index": 33,
      "text": "\u0427\u0430\u0441\u0442\u044c VII. \u0417\u0430\u0432\u0435\u0440\u0435\u043d\u0438\u0435, \u0440\u0435\u0430\u0433\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0435 \u0436\u0438\u0437\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u0446\u0438\u043a\u043b\u0430",
      "style": "normal"
    },
    {
      "para_index": 38,
      "text": "\u0427\u0430\u0441\u0442\u044c VIII. \u042d\u0442\u0430\u043b\u043e\u043d\u043d\u0430\u044f \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0438 \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u044b\u0439 \u0437\u0430\u043f\u0443\u0441\u043a",
      "style": "normal"
    },
    {
      "para_index": 43,
      "text": "\u0417\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435. \u041e\u0442 \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u043a \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435",
      "style": "normal"
    },
    {
      "para_index": 44,
      "text": "\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f",
      "style": "normal"
    },
    {
      "para_index": 53,
      "text": "\u0418\u043c\u044f \u0430\u0432\u0442\u043e\u0440\u0430: [\u0438\u043c\u044f / \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u043e\u0435 \u0438\u043c\u044f]",
      "style": "normal"
    },
    {
      "para_index": 54,
      "text": "\u041a\u043e\u0440\u043e\u0442\u043a\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f \u0434\u043b\u044f \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438 \u043a\u043d\u0438\u0433\u0438, 50-70 \u0441\u043b\u043e\u0432: [\u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c]",
      "style": "normal"
    },
    {
      "para_index": 55,
      "text": "\u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u043d\u0430\u044f \u0431\u0438\u043e\u0433\u0440\u0430\u0444\u0438\u044f, 120-150 \u0441\u043b\u043e\u0432: [\u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c]",
      "style": "normal"
    },
    {
      "para_index": 56,
      "text": "\u0422\u0435\u043a\u0443\u0449\u0430\u044f \u0440\u043e\u043b\u044c \u0438\u043b\u0438 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0435 \u043f\u043e\u0437\u0438\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435: [\u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c]",
      "style": "normal"
    },
    {
      "para_index": 57,
      "text": "\u0420\u0435\u043b\u0435\u0432\u0430\u043d\u0442\u043d\u044b\u0439 \u043e\u043f\u044b\u0442: [1-2 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c\u044b\u0445 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0431\u0435\u0437 \u043d\u0435\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043d\u044b\u0445 \u0446\u0438\u0444\u0440]",
      "style": "normal"
    },
    {
      "para_index": 58,
      "text": "\u041f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0435 \u0441\u0441\u044b\u043b\u043a\u0438: [\u0441\u0430\u0439\u0442] / [GitHub] / [\u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0444\u0438\u043b\u0438]",
      "style": "normal"
    },
    {
      "para_index": 59,
      "text": "\u041a\u043e\u043d\u0442\u0430\u043a\u0442 \u0434\u043b\u044f \u0438\u0437\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430: [\u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c]",
      "style": "normal"
    },
    {
      "para_index": 60,
      "text": "\u0424\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u043a\u0430 \u0434\u043b\u044f \u043e\u0431\u043b\u043e\u0436\u043a\u0438 \u0438\u043b\u0438 \u043a\u0430\u0442\u0430\u043b\u043e\u0436\u043d\u043e\u0439 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438: [\u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c]",
      "style": "normal"
    },
    {
      "para_index": 61,
      "text": "\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u0438: [\u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u0438\u043b\u0438 \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u0441\u0442\u0440\u043e\u043a\u0443]",
      "style": "normal"

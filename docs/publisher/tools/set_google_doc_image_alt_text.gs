function collectInlineImages(element, images) {
  if (element.getType() === DocumentApp.ElementType.INLINE_IMAGE) {
    images.push(element);
    return;
  }
  if (typeof element.getNumChildren !== 'function') {
    return;
  }
  for (let index = 0; index < element.getNumChildren(); index += 1) {
    collectInlineImages(element.getChild(index), images);
  }
}

function setImageAltText() {
  const document = DocumentApp.openById(DOCUMENT_ID);
  const tab = document.getTab(TAB_ID).asDocumentTab();
  const images = [];
  collectInlineImages(tab.getBody(), images);

  if (images.length !== ALT_DESCRIPTIONS.length) {
    throw new Error(
      `Expected ${ALT_DESCRIPTIONS.length} images, found ${images.length}.`,
    );
  }

  images.forEach((image, index) => {
    image.setAltTitle(`Рисунок ${index + 1}`);
    image.setAltDescription(ALT_DESCRIPTIONS[index]);
  });
  document.setLanguage('ru');
  document.saveAndClose();
  console.log(`Updated ${images.length} images in ${DOCUMENT_ID}.`);
}
